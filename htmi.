<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>火车站多站台候车大屏</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:"Microsoft YaHei",sans-serif;}
body{width:100vw;height:100vh;overflow:hidden;display:flex;flex-direction:column;background:#000;}
/* 顶部站名栏 */
.station-header{width:100%;height:18vh;background:#0f243a;display:flex;flex-direction:column;justify-content:center;align-items:center;color:#fff;flex-shrink:0;margin-bottom:12px;}
.station-cn{font-size:9vh;font-weight:bold;letter-spacing:0.6vw;}
.station-en{font-size:3vh;margin-top:1vh;opacity:0.9;}
/* 主体左右分栏容器 */
.main-container{flex:1;display:flex;gap:16px;padding:0 12px;overflow:hidden;}
.col-left,.col-right{flex:1;display:flex;flex-direction:column;gap:16px;}
/* 单组三联站台模块 */
.platform-group{display:flex;gap:12px;align-items:center;height:24vh;}
/* 偶数站台：左 */
.platform-even{flex:1;height:100%;background:#111;color:#ffdd00;display:grid;grid-template-columns:60px 1fr;}
/* 奇数站台：右 */
.platform-odd{flex:1;height:100%;background:#111;color:#ffdd00;display:grid;grid-template-columns:1fr 60px;}
/* 站台侧边大号数字 */
.platform-num{display:flex;justify-content:center;align-items:center;font-size:8vh;font-weight:bold;color:#fff;background:#0a1828;}
/* 站台文字内容区 */
.platform-content{display:flex;flex-direction:column;justify-content:center;align-items:center;padding:8px;gap:12px;height:100%;}
.train-top{font-size:4vh;display:flex;width:100%;justify-content:space-between;padding:0 10px;}
.train-line{font-size:3.8vh;}
/* 空站台黄色标语 */
.empty-text{color:#ffdd00;text-align:center;display:flex;flex-direction:column;gap:20px;height:100%;justify-content:center;font-size:3.6vh;font-weight:bold;}
/* 中间时钟 */
.clock-wrap{width:14vh;height:14vh;border-radius:50%;background:#fff;display:flex;justify-content:center;align-items:center;position:relative;flex-shrink:0;}
.clock-face{width:92%;height:92%;border-radius:50%;position:relative;background:#fff;}
.clock-num{position:absolute;font-size:2vh;color:#000;font-weight:bold;}
.clock-num12{top:4px;left:50%;transform:translateX(-50%);}
.clock-num3{right:4px;top:50%;transform:translateY(-50%);}
.clock-num6{bottom:4px;left:50%;transform:translateX(-50%);}
.clock-num9{left:4px;top:50%;transform:translateY(-50%);}
.h-hand,.m-hand{position:absolute;left:50%;bottom:50%;transform-origin:bottom center;background:#000;border-radius:4px;}
.h-hand{width:8px;height:35%;margin-left:-4px;z-index:3;}
.m-hand{width:6px;height:45%;margin-left:-3px;z-index:4;}
/* 编辑面板 */
.edit-btn{position:fixed;top:10px;right:10px;z-index:99;padding:6px 12px;background:#2382d2;color:#fff;border:none;border-radius:4px;font-size:14px;cursor:pointer;}
.edit-panel{position:fixed;top:50px;right:10px;width:400px;background:#0a1828;border:1px solid #4488dd;padding:16px;color:#fff;display:none;z-index:99;max-height:85vh;overflow-y:auto;}
.edit-title{font-size:18px;font-weight:bold;margin-bottom:12px;color:#fff;}
.block-line{margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #446;}
.input-item{width:100%;padding:8px;font-size:16px;margin-bottom:8px;color:#000;}
.btn-row{display:flex;gap:8px;margin-top:12px;}
.btn{flex:1;padding:8px;border:none;border-radius:4px;font-size:15px;cursor:pointer;}
.btn-save{background:#217ad9;color:#fff;}
.btn-add{background:#23a24d;color:#fff;}
.rule-desc{font-size:13px;color:#ccc;margin-top:12px;line-height:1.5;}
.item{margin-bottom:10px;}
.item label{display:block;margin-bottom:4px;font-size:14px;}
</style>
</head>
<body>
<!-- 顶部站名（英文已修正为Luohexi） -->
<div class="station-header">
<div class="station-cn" id="cnStation">漯河西站</div>
<div class="station-en" id="enStation">Luohexi Railway Station</div>
</div>
<!-- 编辑按钮 -->
<button class="edit-btn" id="toggleEdit">打开后台编辑</button>
<!-- 主体站台区域（已删除底部栏相关HTML） -->
<div class="main-container">
<div class="col-left" id="colLeft">
<!-- 组1：2+1 -->
<div class="platform-group" data-pair="1">
<div class="platform-even" data-station="2">
<div class="platform-num">2</div>
<div class="platform-content"></div>
</div>
<div class="clock-wrap"><div class="clock-face"><div class="clock-num clock-num12">12</div><div class="clock-num clock-num3">3</div><div class="clock-num clock-num6">6</div><div class="clock-num clock-num9">9</div><div class="h-hand" id="hHand"></div><div class="m-hand" id="mHand"></div></div></div>
<div class="platform-odd" data-station="1">
<div class="platform-content"></div>
<div class="platform-num">1</div>
</div>
</div>
<!-- 组2：4+3 -->
<div class="platform-group" data-pair="2">
<div class="platform-even" data-station="4">
<div class="platform-num">4</div>
<div class="platform-content"></div>
</div>
<div class="clock-wrap"><div class="clock-face"><div class="clock-num clock-num12">12</div><div class="clock-num clock-num3">3</div><div class="clock-num clock-num6">6</div><div class="clock-num clock-num9">9</div><div class="h-hand"></div><div class="m-hand"></div></div></div>
<div class="platform-odd" data-station="3">
<div class="platform-content"></div>
<div class="platform-num">3</div>
</div>
</div>
<!-- 组3：6+5 -->
<div class="platform-group" data-pair="3">
<div class="platform-even" data-station="6">
<div class="platform-num">6</div>
<div class="platform-content"></div>
</div>
<div class="clock-wrap"><div class="clock-face"><div class="clock-num clock-num12">12</div><div class="clock-num clock-num3">3</div><div class="clock-num clock-num6">6</div><div class="clock-num clock-num9">9</div><div class="h-hand"></div><div class="m-hand"></div></div></div>
<div class="platform-odd" data-station="5">
<div class="platform-content"></div>
<div class="platform-num">5</div>
</div>
</div>
</div>
<div class="col-right" id="colRight">
<!-- 组4：8+7 -->
<div class="platform-group" data-pair="4">
<div class="platform-even" data-station="8">
<div class="platform-num">8</div>
<div class="platform-content"></div>
</div>
<div class="clock-wrap"><div class="clock-face"><div class="clock-num clock-num12">12</div><div class="clock-num clock-num3">3</div><div class="clock-num clock-num6">6</div><div class="clock-num clock-num9">9</div><div class="h-hand"></div><div class="m-hand"></div></div></div>
<div class="platform-odd" data-station="7">
<div class="platform-content"></div>
<div class="platform-num">7</div>
</div>
</div>
<!-- 组5：10+9 -->
<div class="platform-group" data-pair="5">
<div class="platform-even" data-station="10">
<div class="platform-num">10</div>
<div class="platform-content"></div>
</div>
<div class="clock-wrap"><div class="clock-face"><div class="clock-num clock-num12">12</div><div class="clock-num clock-num3">3</div><div class="clock-num clock-num6">6</div><div class="clock-num clock-num9">9</div><div class="h-hand"></div><div class="m-hand"></div></div></div>
<div class="platform-odd" data-station="9">
<div class="platform-content"></div>
<div class="platform-num">9</div>
</div>
</div>
<!-- 组6：12+11 -->
<div class="platform-group" data-pair="6">
<div class="platform-even" data-station="12">
<div class="platform-num">12</div>
<div class="platform-content"></div>
</div>
<div class="clock-wrap"><div class="clock-face"><div class="clock-num clock-num12">12</div><div class="clock-num clock-num3">3</div><div class="clock-num clock-num6">6</div><div class="clock-num clock-num9">9</div><div class="h-hand"></div><div class="m-hand"></div></div></div>
<div class="platform-odd" data-station="11">
<div class="platform-content"></div>
<div class="platform-num">11</div>
</div>
</div>
</div>
</div>
<!-- 后台编辑面板 -->
<div class="edit-panel" id="editPanel">
<div class="edit-title">车次/站名编辑面板</div>
<div class="block-line">
<div class="rule-desc">时效规则：始发车开车前8分钟上屏、过路车开车前7分钟上屏；普通车开车1分钟清除；终到车到站10分钟清除；同站台有后车则立刻切换</div>
</div>
<div class="item">
<label>顶部中文站名</label>
<input class="input-item" id="editCnStation" placeholder="如：漯河西站">
</div>
<div class="item">
<label>顶部英文站名</label>
<input class="input-item" id="editEnStation" placeholder="如：Luohexi Railway Station">
</div>
<div class="item">
<label>目标站台号（1-12）</label>
<input class="input-item" id="editPlat" placeholder="数字">
</div>
<div class="item">
<label>车次</label>
<input class="input-item" id="editTrainNo" placeholder="G/D/C字头">
</div>
<div class="item">
<label>始发站</label>
<input class="input-item" id="editFrom" placeholder="始发站名">
</div>
<div class="item">
<label>终到站</label>
<input class="input-item" id="editTo" placeholder="终到站名">
</div>
<div class="item">
<label>开车时间 HH:mm</label>
<input class="input-item" id="editDep" placeholder="14:30">
</div>
<div class="btn-row">
<button class="btn btn-add" id="btnAddTrain">添加车次</button>
<button class="btn btn-save" id="btnClearPlat">清空该站台</button>
</div>
</div>

<script>
// 全局时效常量
const DEPART_LOCAL_MIN = 8;
const PASS_LOCAL_MIN = 7;
const CLEAR_AFTER_DEPART_MIN = 1;
const ARRIVE_CLEAR_MIN = 10;
const STOP_CHECK_MIN = 5;

let stationCn = "漯河西站";
let stationEn = "Luohexi Railway Station";
let platformTrains = {};
let clockTimer, refreshTimer;

const $ = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);

// 更新顶部站名
function updateStationName(){
  $("#cnStation").innerText = stationCn;
  $("#enStation").innerText = stationEn;
}
// 格式化时间
function pad2(n){return n<10?"0"+n:n;}
function getNowHM(){
  const d = new Date();
  return {h:d.getHours(),m:d.getMinutes(),s:d.getSeconds()};
}
// 获取当天时间戳
function getDayTs(h,m){
  const now = new Date();
  return new Date(now.getFullYear(),now.getMonth(),now.getDate(),h,m).getTime();
}
// 计算分钟差
function getMinDiff(targetH,targetM){
  const now = new Date();
  const target = getDayTs(targetH,targetM);
  const diffMs = target - now.getTime();
  return Math.floor(diffMs / (60*1000));
}
// 单独渲染单条车次
function renderSingleTrain(box, train, isEven){
  if(isEven){
    box.innerHTML = `
      <div class="train-top">
        <span>${train.depTime}开</span>
        <span>${train.no}</span>
      </div>
      <div class="train-line">${train.to} ← ${train.from}</div>
    `;
  }else{
    box.innerHTML = `
      <div class="train-top">
        <span>${train.no}</span>
        <span>${train.depTime}开</span>
      </div>
      <div class="train-line">${train.from} → ${train.to}</div>
    `;
  }
}
// 渲染单站台面板（修复切换逻辑）
function renderPlatform(platEl, platNum){
  const contentBox = platEl.querySelector(".platform-content");
  const trains = platformTrains[platNum] || [];
  const now = new Date();
  const stationName = stationCn;
  let allValidTrains = [];

  for(const t of trains){
    const [depH,depM] = t.depTime.split(":").map(Number);
    const diffMin = getMinDiff(depH,depM);
    const isStart = t.from === stationName;
    const isArrive = t.to === stationName;
    const depTs = getDayTs(depH,depM);
    const arriveDiff = now.getTime() - depTs;
    let canShow = false;

    if(isStart){
      if(diffMin >= 0 && diffMin <= DEPART_LOCAL_MIN) canShow = true;
    }else if(!isArrive){
      if(diffMin >=0 && diffMin <= PASS_LOCAL_MIN) canShow = true;
    }
    if(isArrive && arriveDiff >=0 && arriveDiff <= ARRIVE_CLEAR_MIN*60*1000){
      canShow = true;
    }
    if(!isArrive && arriveDiff > CLEAR_AFTER_DEPART_MIN*60*1000) continue;
    if(canShow) allValidTrains.push({...t, diffMin, isStart, isArrive, depTs});
  }
  allValidTrains.sort((a,b)=> a.depTs - b.depTs);
  if(allValidTrains.length === 0){
    contentBox.innerHTML = `
      <div class="empty-text">
        <div>不忘初心，牢记使命。</div>
        <div>交通强国，铁路先行。</div>
      </div>
    `;
    return;
  }
  const firstTrain = allValidTrains[0];
  const hasNextTrain = allValidTrains.length > 1;
  const nowTs = now.getTime();
  const firstDepartDiff = nowTs - firstTrain.depTs;
  if(hasNextTrain){
    if((!firstTrain.isArrive && firstDepartDiff > 0) || (firstTrain.isArrive && firstDepartDiff > 60*1000)){
      renderSingleTrain(contentBox, allValidTrains[1], platEl.classList.contains("platform-even"));
      return;
    }
  }
  renderSingleTrain(contentBox, firstTrain, platEl.classList.contains("platform-even"));
}
// 刷新全部站台
function refreshAllPlatform(){
  $$(".platform-even,.platform-odd").forEach(el=>{
    const p = el.dataset.station;
    renderPlatform(el, p);
  })
}
// 实时转动时钟
function updateClock(){
  const now = new Date();
  const h = now.getHours() % 12;
  const m = now.getMinutes();
  const hDeg = h * 30 + m * 0.5;
  const mDeg = m * 6;
  $("#hHand").style.transform = `translateX(-50%) rotate(${hDeg}deg)`;
  $("#mHand").style.transform = `translateX(-50%) rotate(${mDeg}deg)`;
}
// 切换编辑面板
function toggleEditPanel(){
  const panel = $("#editPanel");
  const btn = $("#toggleEdit");
  if(panel.style.display === "block"){
    panel.style.display = "none";
    btn.innerText = "打开后台编辑";
  }else{
    panel.style.display = "block";
    btn.innerText = "关闭后台编辑";
    $("#editCnStation").value = stationCn;
    $("#editEnStation").value = stationEn;
  }
}
// 添加车次（添加后立刻刷新）
function addTrain(){
  const plat = $("#editPlat").value.trim();
  const no = $("#editTrainNo").value.trim();
  const from = $("#editFrom").value.trim();
  const to = $("#editTo").value.trim();
  const dep = $("#editDep").value.trim();
  if(!plat || !no || !from || !to || !dep){
    alert("请完整填写所有车次信息");
    return;
  }
  if(!/^\d+$/.test(plat) || plat<1 || plat>12){
    alert("站台号必须是1-12数字");
    return;
  }
  if(!/^\d{1,2}:\d{2}$/.test(dep)){
    alert("开车时间格式 HH:mm");
    return;
  }
  if(!platformTrains[plat]) platformTrains[plat] = [];
  platformTrains[plat].push({no,from,to,depTime:dep});
  $("#editTrainNo").value = "";
  $("#editFrom").value = "";
  $("#editTo").value = "";
  $("#editDep").value = "";
  refreshAllPlatform();
}
// 清空站台
function clearPlatform(){
  const plat = $("#editPlat").value.trim();
  if(!plat) return;
  platformTrains[plat] = [];
  refreshAllPlatform();
}
// 保存站名
function saveStationName(){
  stationCn = $("#editCnStation").value.trim();
  stationEn = $("#editEnStation").value.trim();
  updateStationName();
}
// 绑定事件
function bindEvents(){
  $("#toggleEdit").addEventListener("click", toggleEditPanel);
  $("#btnAddTrain").addEventListener("click", addTrain);
  $("#btnClearPlat").addEventListener("click", clearPlatform);
  $("#editCnStation").addEventListener("change", saveStationName);
  $("#editEnStation").addEventListener("change", saveStationName);
}
// 初始化
function init(){
  updateStationName();
  bindEvents();
  updateClock();
  refreshAllPlatform();
  clockTimer = setInterval(updateClock, 1000);
  refreshTimer = setInterval(refreshAllPlatform, 1000);
}
window.onload = init;
</script>
</body>
</html>
